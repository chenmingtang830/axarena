{
  "name": "axarena-publication",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:data && next build --webpack",
    "start": "npx serve out",
    "test": "npm run validate:data && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:data": "node --experimental-strip-types scripts/validate-publication.ts"
  },
  "dependencies": {
    "d3-scale": "4.0.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22"
  }
}
